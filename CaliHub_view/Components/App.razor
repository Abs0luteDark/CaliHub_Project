                            "on-primary-container": "#2e1500",
                            "on-surface": "#e4e1e7",
                            "on-surface-variant": "#dcc2ae",
                            "outline": "#a48c7a",
                            "background": "#131317"
                        },
                        "fontFamily": {
                            "body-md": ["Rubik", "sans-serif"]
                        }
                    }
                }
            }
    </script>

    <link rel="stylesheet" href="css/site.css" />
    <HeadOutlet />
