@page "/"

<div class="flex flex-col w-full">
    <!-- Hero Section -->
    <section class="relative w-full overflow-hidden flex flex-col items-center justify-center min-h-[calc(100vh-5rem)] px-4 sm:px-8 py-10">
        <!-- Ambient Glow Effects -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary-container/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] h-[320px] bg-primary-container/15 rounded-full blur-[80px] pointer-events-none -z-10"></div>

        <div class="max-w-4xl w-full mx-auto flex flex-col items-center text-center relative z-10">
            <!-- Centered Official Brand Card Display -->
            <div class="relative group my-6 w-full max-w-xl mx-auto">
                <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-primary-container/20 via-primary/30 to-primary-container/20 opacity-70 blur-xl group-hover:opacity-100 transition-opacity duration-700"></div>
                <div class="relative rounded-xl bg-surface-container-lowest p-6 sm:p-8 shadow-2xl flex flex-col items-center justify-center border border-outline-variant/30">
                    <img alt="CaliHub Official Brand Logo" class="w-full max-w-md h-auto object-contain drop-shadow-[0_4px_30px_rgba(255,144,0,0.25)] transition-transform duration-500 hover:scale-[1.02]" src="@Assets["images/CaliHub-logo.png"]" />
                </div>
            </div>

            <!-- Typography & Canvas Statement -->
            <div class="mt-6 space-y-4 max-w-4xl mx-auto flex flex-col items-center text-center">
                <h1 class="text-3xl sm:text-[40px] sm:leading-[48px] font-extrabold text-on-surface tracking-tight">
                    <span class="text-on-surface">הבית של </span>
                    <span class="text-primary drop-shadow-[0_2px_15px_rgba(255,144,0,0.4)]">קהילת הקליסטניקס</span>
                    <span class="text-on-surface"> בישראל</span>
                </h1>
                <p class="text-base sm:text-lg text-on-surface-variant leading-relaxed max-w-2xl mx-auto">
                    הפלטפורמה המקיפה לאתלטי משקל גוף: גילוי ודירוג מתחמי פארק ברחבי הארץ, תוכניות אימון מקצועיות, תיאום סשנים חיים וקהילת ספורטאים מובילה.
                </p>
                <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
                    <a href="/register" class="inline-flex items-center justify-center gap-2 px-8 py-3 rounded-lg bg-primary-container text-on-primary-container text-base font-bold shadow-[0_0_25px_rgba(255,144,0,0.4)] hover:shadow-[0_0_30px_rgba(255,144,0,0.65)] hover:scale-105 transition-all duration-300">
                        <span class="material-symbols-outlined text-[20px]">bolt</span>
                        <span>הצטרף בחינם</span>
                    </a>
                    <a href="/login" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-surface-container-high/60 hover:bg-surface-container-highest text-on-surface text-base font-semibold transition-all duration-300 hover:text-primary">
                        <span class="material-symbols-outlined text-[20px] text-outline">login</span>
                        <span>כניסה</span>
                    </a>
                </div>
            </div>

            <!-- 5 Blueprint Blocks Grid -->
            <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-12 text-right">
                <!-- Block 01 -->
                <div class="group relative rounded-xl bg-surface-container p-4 border border-outline-variant/30 hover:border-primary/50 shadow-sm hover:bg-surface-container-high transition-all duration-300">
                    <div class="flex items-center justify-between mb-3">
                        <span class="w-8 h-8 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-colors">
                            <span class="material-symbols-outlined text-[20px]">fitness_center</span>
                        </span>
                        <span class="text-xs text-outline font-semibold tracking-wider uppercase">בלוק 01</span>
                    </div>
                    <h3 class="text-lg font-bold text-on-surface group-hover:text-primary transition-colors">תוכניות אימון</h3>
                    <p class="text-sm text-on-surface-variant mt-1">מערך סטים, פרוגרסיב אוברלואד ואימוני משקל גוף מותאמים.</p>
                </div>

                <!-- Block 02 -->
                <div class="group relative rounded-xl bg-surface-container p-4 border border-outline-variant/30 hover:border-primary/50 shadow-sm hover:bg-surface-container-high transition-all duration-300">
                    <div class="flex items-center justify-between mb-3">
                        <span class="w-8 h-8 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-colors">
                            <span class="material-symbols-outlined text-[20px]">map</span>
                        </span>
                        <span class="text-xs text-outline font-semibold tracking-wider uppercase">בלוק 02</span>
                    </div>
                    <h3 class="text-lg font-bold text-on-surface group-hover:text-primary transition-colors">מפת פארקים</h3>
                    <p class="text-sm text-on-surface-variant mt-1">איתור מתחמי מתח, מקבילים וקבוצות אימון בזמן אמת.</p>
                </div>

                <!-- Block 03 -->
                <div class="group relative rounded-xl bg-surface-container p-4 border border-outline-variant/30 hover:border-primary/50 shadow-sm hover:bg-surface-container-high transition-all duration-300">
                    <div class="flex items-center justify-between mb-3">
                        <span class="w-8 h-8 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-colors">
                            <span class="material-symbols-outlined text-[20px]">event_available</span>
                        </span>
                        <span class="text-xs text-outline font-semibold tracking-wider uppercase">בלוק 03</span>
                    </div>
                    <h3 class="text-lg font-bold text-on-surface group-hover:text-primary transition-colors">תיאום אימונים</h3>
                    <p class="text-sm text-on-surface-variant mt-1">קביעת מקום וזמן לסשן משותף, אימוני קבוצות ומפגשים.</p>
                </div>

                <!-- Block 04 -->
                <div class="group relative rounded-xl bg-surface-container p-4 border border-outline-variant/30 hover:border-primary/50 shadow-sm hover:bg-surface-container-high transition-all duration-300">
                    <div class="flex items-center justify-between mb-3">
                        <span class="w-8 h-8 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-colors">
                            <span class="material-symbols-outlined text-[20px]">groups</span>
                        </span>
                        <span class="text-xs text-outline font-semibold tracking-wider uppercase">בלוק 04</span>
                    </div>
                    <h3 class="text-lg font-bold text-on-surface group-hover:text-primary transition-colors">קהילת מתאמנים</h3>
                    <p class="text-sm text-on-surface-variant mt-1">אתגרים חודשיים, שיאי PR ואינטראקציה בין ספורטאים.</p>
                </div>

                <!-- Block 05: CaliBot AI -->
                <div id="calibot-section" class="group relative rounded-xl bg-surface-container p-5 border border-primary/30 shadow-[0_0_15px_rgba(255,144,0,0.2)] transition-all duration-300 sm:col-span-2 lg:col-span-4">
                    <div class="flex items-center justify-between mb-3">
                        <span class="w-8 h-8 rounded-lg bg-primary-container/20 border border-primary-container/40 flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-colors">
                            <span class="material-symbols-outlined text-[20px]">smart_toy</span>
                        </span>
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded bg-primary-container/20 text-primary text-[10px] font-bold">חדש</span>
                            <span class="text-xs text-primary font-semibold tracking-wider uppercase">בלוק 05</span>
                        </div>
                    </div>
                    <h3 class="text-xl font-bold text-primary flex items-center gap-2">
                        <span>מאמן CaliBot AI</span>
                        <span class="w-2.5 h-2.5 rounded-full bg-[#10b981] shadow-[0_0_8px_#10b981] inline-block"></span>
                    </h3>
                    <p class="text-sm text-on-surface-variant mt-2">מאמן אישי חכם 24/7 לדיוק טכניקה, התאמת עומסים ובניית תוכניות אימון אישיות לפי רמת הכוח שלך.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- "How It Works" Section -->
    <section class="w-full py-16 px-4 sm:px-8 relative overflow-hidden bg-surface-container-lowest/80 border-t border-outline-variant/30">
        <div class="max-w-7xl mx-auto flex flex-col items-center">
            <div class="text-center space-y-2 mb-12">
                <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-primary-container/15 border border-primary-container/30 text-primary text-xs uppercase tracking-wider">
                    <span class="material-symbols-outlined text-[16px]">route</span>
                    <span>המסלול שלך להצלחה</span>
                </div>
                <h2 class="text-3xl sm:text-[36px] font-extrabold text-on-surface tracking-tight mt-2">איך זה עובד?</h2>
                <p class="text-base sm:text-lg text-on-surface-variant max-w-2xl mx-auto">מחיבור לקהילה ועד לאימון מושלם על המתח - 4 צעדים פשוטים</p>
            </div>

            <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-right">
                <!-- Step 01 -->
                <div class="relative flex flex-col bg-surface-container rounded-xl p-6 border border-outline-variant/40 hover:border-primary/50 hover:shadow-[0_0_20px_rgba(255,144,0,0.2)] transition-all duration-300 group">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-xl bg-surface-container-highest flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-all duration-300 shadow-sm">
                            <span class="material-symbols-outlined text-[26px]">badge</span>
                        </div>
                        <span class="text-[28px] font-extrabold text-outline-variant group-hover:text-primary transition-colors">01</span>
                    </div>
                    <h3 class="text-xl font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">נרשמים</h3>
                    <p class="text-sm text-on-surface-variant leading-relaxed">הרשמה מהירה בחינם, פתיחת פרופיל מתאמן והגדרת יעדים אישיים בהתאמה מדויקת.</p>
                    <div class="mt-auto pt-4 flex items-center gap-1 text-primary text-xs font-semibold">
                        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                        <span>צעד ראשון</span>
                    </div>
                </div>

                <!-- Step 02 -->
                <div class="relative flex flex-col bg-surface-container rounded-xl p-6 border border-outline-variant/40 hover:border-primary/50 hover:shadow-[0_0_20px_rgba(255,144,0,0.2)] transition-all duration-300 group">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-xl bg-surface-container-highest flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-all duration-300 shadow-sm">
                            <span class="material-symbols-outlined text-[26px]">pin_drop</span>
                        </div>
                        <span class="text-[28px] font-extrabold text-outline-variant group-hover:text-primary transition-colors">02</span>
                    </div>
                    <h3 class="text-xl font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">מוצאים פארק / קבוצה</h3>
                    <p class="text-sm text-on-surface-variant leading-relaxed">איתור מתחמי קליסטניקס קרובים לפי מיקום וחיבור ישיר לקבוצות אימון מקומיות פעילות.</p>
                    <div class="mt-auto pt-4 flex items-center gap-1 text-primary text-xs font-semibold">
                        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                        <span>חיבור לסביבה</span>
                    </div>
                </div>

                <!-- Step 03 -->
                <div class="relative flex flex-col bg-surface-container rounded-xl p-6 border border-outline-variant/40 hover:border-primary/50 hover:shadow-[0_0_20px_rgba(255,144,0,0.2)] transition-all duration-300 group">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-xl bg-surface-container-highest flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-all duration-300 shadow-sm">
                            <span class="material-symbols-outlined text-[26px]">smart_toy</span>
                        </div>
                        <span class="text-[28px] font-extrabold text-outline-variant group-hover:text-primary transition-colors">03</span>
                    </div>
                    <h3 class="text-xl font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">מתייעצים עם ה-AI</h3>
                    <p class="text-sm text-on-surface-variant leading-relaxed">קבלת תוכנית מותאמת אישית, שאלות על טכניקה נכונה ודיוק עומסים בליווי CaliBot.</p>
                    <div class="mt-auto pt-4 flex items-center gap-1 text-primary text-xs font-semibold">
                        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                        <span>התאמה חכמה</span>
                    </div>
                </div>

                <!-- Step 04 -->
                <div class="relative flex flex-col bg-surface-container rounded-xl p-6 border border-outline-variant/40 hover:border-primary/50 hover:shadow-[0_0_20px_rgba(255,144,0,0.2)] transition-all duration-300 group">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-xl bg-surface-container-highest flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-all duration-300 shadow-sm">
                            <span class="material-symbols-outlined text-[26px]">bolt</span>
                        </div>
                        <span class="text-[28px] font-extrabold text-outline-variant group-hover:text-primary transition-colors">04</span>
                    </div>
                    <h3 class="text-xl font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">יוצאים להתאמן!</h3>
                    <p class="text-sm text-on-surface-variant leading-relaxed">קביעת מועד, הגעה למתחם, שבירת שיאים אישיים (PR) והתקדמות מתמדת מאימון לאימון.</p>
                    <div class="mt-auto pt-4 flex items-center gap-1 text-primary text-xs font-semibold">
                        <span class="material-symbols-outlined text-[16px]">check_circle</span>
                        <span>סשן באוויר</span>
                    </div>
                </div>
            </div>

            <div class="mt-12 flex justify-center">
                <a href="/register" class="inline-flex items-center justify-center gap-2 px-8 py-3 rounded-lg bg-primary-container text-on-primary-container text-lg font-bold shadow-[0_0_25px_rgba(255,144,0,0.4)] hover:shadow-[0_0_30px_rgba(255,144,0,0.65)] hover:scale-105 transition-all duration-300">
                    <span class="material-symbols-outlined text-[20px]">rocket_launch</span>
                    <span>מתחילים עכשיו</span>
                </a>
            </div>
        </div>
    </section>
</div>