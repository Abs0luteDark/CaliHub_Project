@page "/"

<!-- 1. אזור Hero ראשי (Atmospheric Canvas) -->
<section class="py-5 text-center position-relative overflow-hidden">
    <!-- אפקט הילה כתום ברקע -->
    <div class="position-absolute top-50 start-50 translate-middle rounded-circle bg-primary opacity-10 blur-3xl pointer-events-none -z-1"
         style="width: 500px; height: 500px; filter: blur(100px);"></div>

    <div class="container relative-z-10 py-3">
        <!-- כרטיס הלוגו המרכזי -->
        <div class="row justify-content-center mb-4">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card card-custom p-4 border-secondary shadow-lg transition-transform"
                     style="background-color: #0e0e12; box-shadow: 0 0 35px rgba(255,144,0,0.2) !important;">
                    <img src="@Assets["images/CaliHub-logo.png"]"
                         alt="CaliHub Official Brand Logo"
                         class="img-fluid mx-auto"
                         style="max-height: 150px; object-fit: contain;" />
                </div>
            </div>
        </div>

        <!-- כותרת ותיאור ראשי -->
        <h1 class="display-4 fw-bold text-light mb-3">
            הבית של <span class="text-primary" style="text-shadow: 0 0 15px rgba(255,144,0,0.4);">קהילת הקליסטניקס</span> בישראל
        </h1>
        <p class="lead text-secondary mx-auto mb-4" style="max-width: 720px;">
            הפלטפורמה המקיפה לאתלטי משקל גוף: גילוי ודירוג מתחמי פארק ברחבי הארץ, תוכניות אימון מקצועיות, תיאום סשנים חיים וקהילת ספורטאים מובילה.
        </p>

        <!-- כפתורי הנעה לפעולה -->
        <div class="d-flex flex-wrap justify-content-center gap-3 mb-5">
            <a href="/register" class="btn btn-primary btn-lg px-4 py-2 fw-bold d-flex align-items-center gap-2 shadow-lg">
                <i class="bi bi-lightning-charge-fill"></i> הצטרף בחינם
            </a>
            <a href="/login" class="btn btn-outline-light btn-lg px-4 py-2 d-flex align-items-center gap-2">
                <i class="bi bi-box-arrow-in-right"></i> כניסה
            </a>
        </div>

        <!-- 5 הבלוקים המרכזיים -->
        <div class="row g-3 text-start">
            <!-- בלוק 01 -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card card-custom p-3 h-100 border-secondary hover-border-primary transition-all">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="p-2 bg-dark rounded text-primary border border-secondary">
                            <i class="bi bi-journal-bookmark-fill fs-5"></i>
                        </span>
                        <span class="badge bg-dark text-secondary border border-secondary uppercase">בלוק 01</span>
                    </div>
                    <h5 class="fw-bold text-light mb-1">תוכניות אימון</h5>
                    <p class="text-secondary small mb-0">מערך סטים, פרוגרסיב אוברלואד ואימוני משקל גוף מותאמים.</p>
                </div>
            </div>

            <!-- בלוק 02 -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card card-custom p-3 h-100 border-secondary hover-border-primary transition-all">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="p-2 bg-dark rounded text-primary border border-secondary">
                            <i class="bi bi-geo-alt-fill fs-5"></i>
                        </span>
                        <span class="badge bg-dark text-secondary border border-secondary uppercase">בלוק 02</span>
                    </div>
                    <h5 class="fw-bold text-light mb-1">מפת פארקים</h5>
                    <p class="text-secondary small mb-0">איתור מתחמי מתח, מקבילים וקבוצות אימון בזמן אמת.</p>
                </div>
            </div>

            <!-- בלוק 03 -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card card-custom p-3 h-100 border-secondary hover-border-primary transition-all">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="p-2 bg-dark rounded text-primary border border-secondary">
                            <i class="bi bi-calendar-check-fill fs-5"></i>
                        </span>
                        <span class="badge bg-dark text-secondary border border-secondary uppercase">בלוק 03</span>
                    </div>
                    <h5 class="fw-bold text-light mb-1">תיאום אימונים</h5>
                    <p class="text-secondary small mb-0">קביעת מקום וזמן לסשן משותף, אימוני קבוצות ומפגשים.</p>
                </div>
            </div>

            <!-- בלוק 04 -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card card-custom p-3 h-100 border-secondary hover-border-primary transition-all">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="p-2 bg-dark rounded text-primary border border-secondary">
                            <i class="bi bi-people-fill fs-5"></i>
                        </span>
                        <span class="badge bg-dark text-secondary border border-secondary uppercase">בלוק 04</span>
                    </div>
                    <h5 class="fw-bold text-light mb-1">קהילת מתאמנים</h5>
                    <p class="text-secondary small mb-0">אתגרים חודשיים, שיאי PR ואינטראקציה בין ספורטאים.</p>
                </div>
            </div>

            <!-- בלוק 05: CaliBot AI -->
            <div class="col-12">
                <div class="card card-custom p-4 border-primary border-opacity-50 shadow-lg position-relative overflow-hidden"
                     style="background: linear-gradient(135deg, #1b1b1f 0%, #131317 100%);">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-2 gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="p-2 bg-primary bg-opacity-20 rounded text-primary border border-primary border-opacity-30">
                                <i class="bi bi-robot fs-4"></i>
                            </span>
                            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center gap-2">
                                מאמן CaliBot AI
                                <span class="p-1 bg-success rounded-circle d-inline-block shadow-sm" style="width: 8px; height: 8px;"></span>
                            </h4>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-40">חדש</span>
                            <span class="badge bg-dark text-primary border border-secondary uppercase">בלוק 05</span>
                        </div>
                    </div>
                    <p class="text-secondary mb-0">
                        מאמן אישי חכם 24/7 לדיוק טכניקה, התאמת עומסים ובניית תוכניות אימון אישיות לפי רמת הכוח שלך.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. אזור "איך זה עובד?" (4 צעדים) -->
<section class="py-5 border-top border-secondary bg-black text-center position-relative">
    <div class="container py-3">
        <!-- התג העליון -->
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 border border-primary border-opacity-30 text-primary small uppercase mb-3">
            <i class="bi bi-signpost-split-fill"></i> המסלול שלך להצלחה
        </div>
        <h2 class="display-5 fw-bold text-light mb-2">איך זה עובד?</h2>
        <p class="lead text-secondary mx-auto mb-5" style="max-width: 600px;">
            מחיבור לקהילה ועד לאימון מושלם על המתח - 4 צעדים פשוטים
        </p>

        <!-- 4 השלבים -->
        <div class="row g-4 text-start">
            <!-- שלב 01 -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card card-custom p-4 h-100 border-secondary position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="p-3 bg-dark rounded text-primary fs-4 border border-secondary">
                            <i class="bi bi-card-heading"></i>
                        </span>
                        <span class="display-6 fw-bold text-secondary opacity-25">01</span>
                    </div>
                    <h4 class="fw-bold text-light mb-2">נרשמים</h4>
                    <p class="text-secondary small mb-4">הרשמה מהירה בחינם, פתיחת פרופיל מתאמן והגדרת יעדים אישיים בהתאמה מדויקת.</p>
                    <div class="mt-auto pt-2 text-primary small d-flex align-items-center gap-1">
                        <i class="bi bi-arrow-left"></i> צעד ראשון
                    </div>
                </div>
            </div>

            <!-- שלב 02 -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card card-custom p-4 h-100 border-secondary position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="p-3 bg-dark rounded text-primary fs-4 border border-secondary">
                            <i class="bi bi-geo-alt-fill"></i>
                        </span>
                        <span class="display-6 fw-bold text-secondary opacity-25">02</span>
                    </div>
                    <h4 class="fw-bold text-light mb-2">מוצאים פארק / קבוצה</h4>
                    <p class="text-secondary small mb-4">איתור מתחמי קליסטניקס קרובים לפי מיקום וחיבור ישיר לקבוצות אימון מקומיות פעילות.</p>
                    <div class="mt-auto pt-2 text-primary small d-flex align-items-center gap-1">
                        <i class="bi bi-arrow-left"></i> חיבור לסביבה
                    </div>
                </div>
            </div>

            <!-- שלב 03 -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card card-custom p-4 h-100 border-secondary position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="p-3 bg-dark rounded text-primary fs-4 border border-secondary">
                            <i class="bi bi-robot"></i>
                        </span>
                        <span class="display-6 fw-bold text-secondary opacity-25">03</span>
                    </div>
                    <h4 class="fw-bold text-light mb-2">מתייעצים עם ה-AI</h4>
                    <p class="text-secondary small mb-4">קבלת תוכנית מותאמת אישית, שאלות על טכניקה נכונה ודיוק עומסים בליווי CaliBot.</p>
                    <div class="mt-auto pt-2 text-primary small d-flex align-items-center gap-1">
                        <i class="bi bi-arrow-left"></i> התאמה חכמה
                    </div>
                </div>
            </div>

            <!-- שלב 04 -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card card-custom p-4 h-100 border-secondary position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="p-3 bg-dark rounded text-primary fs-4 border border-secondary">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </span>
                        <span class="display-6 fw-bold text-secondary opacity-25">04</span>
                    </div>
                    <h4 class="fw-bold text-light mb-2">יוצאים להתאמן!</h4>
                    <p class="text-secondary small mb-4">קביעת מועד, הגעה למתחם, שבירת שיאים אישיים (PR) והתקדמות מתמדת מאימון לאימון.</p>
                    <div class="mt-auto pt-2 text-primary small d-flex align-items-center gap-1">
                        <i class="bi bi-check-circle-fill"></i> סשן באוויר
                    </div>
                </div>
            </div>
        </div>

        <!-- כפתור הנעה לפעולה בתחתית -->
        <div class="mt-5">
            <a href="/register" class="btn btn-primary btn-lg px-5 py-3 fw-bold fs-5 shadow-lg">
                <i class="bi bi-rocket-takeoff-fill me-2"></i> מתחילים עכשיו
            </a>
        </div>
    </div>
</section>