@inherits LayoutComponentBase

<div class="min-h-screen bg-background text-on-surface flex flex-col font-body-md">
    <!-- Header תפריט עליון -->
    <header class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.5)]">
        <div class="h-20 max-w-7xl mx-auto px-4 sm:px-8 flex items-center justify-between gap-4">
            <div class="flex items-center gap-6">
                <!-- לוגו יחיד -->
                <a href="/" class="flex items-center gap-2">
                    <img src="@Assets["images/CaliHub-logo.png"]" alt="CaliHub" class="h-10 w-auto object-contain transition-transform duration-300 hover:scale-105 drop-shadow-[0_2px_12px_rgba(255,144,0,0.3)]" />
                </a>

                <!-- תפריט קישורים -->
                <nav class="hidden lg:flex items-center gap-2">
                    <a class="group relative flex items-center gap-2 px-3 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" href="#">
                        <span class="material-symbols-outlined text-[20px] text-outline group-hover:text-primary transition-colors">menu_book</span>
                        <span class="font-semibold text-sm">תוכניות אימון</span>
                    </a>
                    <a class="group relative flex items-center gap-2 px-3 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" href="#">
                        <span class="material-symbols-outlined text-[20px] text-outline group-hover:text-primary transition-colors">location_on</span>
                        <span class="font-semibold text-sm">מפת פארקים</span>
                    </a>
                    <a class="group relative flex items-center gap-2 px-3 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" href="#">
                        <span class="material-symbols-outlined text-[20px] text-outline group-hover:text-primary transition-colors">event_available</span>
                        <span class="font-semibold text-sm">תיאום אימונים</span>
                    </a>
                    <a class="group relative flex items-center gap-2 px-3 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" href="#">
                        <span class="material-symbols-outlined text-[20px] text-outline group-hover:text-primary transition-colors">grid_view</span>
                        <span class="font-semibold text-sm">פיד קהילה ומדיה</span>
                    </a>
                    <a class="group relative flex items-center gap-2 px-3 py-2 rounded-lg text-primary hover:text-on-surface hover:bg-surface-container-high transition-all border border-primary/30 shadow-[0_0_12px_rgba(255,144,0,0.2)]" href="#calibot-section">
                        <span class="material-symbols-outlined text-[20px] text-primary group-hover:text-primary transition-colors animate-pulse">smart_toy</span>
                        <span class="font-bold text-sm">מאמן CaliBot AI</span>
                        <span class="px-1.5 py-0.5 rounded bg-primary-container/20 text-primary text-[10px] font-bold">AI</span>
                    </a>
                </nav>
            </div>

            <div class="flex items-center gap-3">
                <a href="/login" class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-sm text-on-surface hover:text-primary transition-colors">התחברות</a>
                <a href="/register" class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-primary-container text-on-primary-container text-sm font-bold shadow-[0_0_20px_rgba(255,144,0,0.35)] hover:shadow-[0_0_25px_rgba(255,144,0,0.5)] transition-all">הרשמה חינם</a>
            </div>
        </div>
    </header>

    <!-- תוכן הדף המשתנה -->
    <main class="w-full pt-20 bg-background flex-grow">
        @Body
    </main>

    <!-- Footer תחתית הדף -->
    <footer class="w-full bg-surface-container-lowest py-8 shadow-[0_-1px_8px_rgba(0,0,0,0.4)] border-t border-outline-variant/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-3">
                <img src="@Assets["images/CaliHub-logo.png"]" alt="CaliHub" class="h-7 w-auto object-contain" />
                <span class="text-base font-semibold text-on-surface">CaliHub קליסטניקס ישראל</span>
            </div>
            <p class="text-xs text-outline">© 2026 CaliHub. כל הזכויות שמורות. אימוני משקל גוף ואינטליגנציה ספורטיבית.</p>
        </div>
    </footer>
</div>